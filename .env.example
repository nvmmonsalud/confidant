# ---------------------------------------------------------------------------
# Confidant — copy to .env and fill in. Nothing here is committed.
# ---------------------------------------------------------------------------

# Run without credentials. Deterministic answers, zero network, zero cost.
# Set to "live" to call the real backends below.
CONFIDANT_MODE=mock

# --- Nebius Token Factory ---------------------------------------------------
# Hermes Agent has a native provider for this: put NEBIUS_API_KEY in
# ~/.hermes/.env and select `nebius-token-factory` (aliases: nebius, nebius-tf).
NEBIUS_API_KEY=
# Override only if the console shows a different host for your project.
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Verify these against GET /v1/models before trusting them:
#   python scripts/probe_models.py
CONFIDANT_MODEL_LIGHT=nvidia/nemotron-3.5-lightning-30b-a3b
CONFIDANT_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Local tier (Ollama) ----------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# PREFER THIS ONE. Hermes' own .env sets OLLAMA_BASE_URL to Ollama *Cloud*, and
# inheriting that turns "local" inference into a network call — the exact
# inversion this project exists to prevent.
CONFIDANT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Local tier model. This one is already on the machine and runs on MLX.
CONFIDANT_MODEL_LOCAL=nemotron-3.5-lightning:30b-mlx
# Pull this for the vision path (on-device document reading):
CONFIDANT_MODEL_LOCAL_VISION=nemotron-3.5-bolt:74b-a9b
# 0 = thinking off. Nemotron 3.5 defaults it ON, spends the whole token budget
# in `thinking`, and returns EMPTY content with done_reason="length".
CONFIDANT_LOCAL_THINK=0

# --- Tavily -----------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- Behaviour --------------------------------------------------------------
CONFIDANT_TIMEOUT=120
# CONFIDANT_DATA=./data
# CONFIDANT_LEDGER=./data/ledger.jsonl
